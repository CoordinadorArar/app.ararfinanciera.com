APP_NAME=ArarFinanciera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.ararfinanciera.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base propia de la aplicación
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=ArarFinanciera
DB_USERNAME=
DB_PASSWORD=

# Sistema de factoring (solo lectura)
DB_FACTORING_HOST=
DB_FACTORING_PORT=1433
DB_FACTORING_DATABASE=FactoringManagerDatos
DB_FACTORING_USERNAME=
DB_FACTORING_PASSWORD=

# SIESA / UnoEE (solo lectura)
DB_UNOEEARAR_HOST=
DB_UNOEEARAR_PORT=1433
DB_UNOEEARAR_DATABASE=UNOEEARAR
DB_UNOEEARAR_USERNAME=
DB_UNOEEARAR_PASSWORD=

# Protección de datos
DB_PROTDATOS_HOST=
DB_PROTDATOS_PORT=1433
DB_PROTDATOS_DATABASE=Protdatos
DB_PROTDATOS_USERNAME=
DB_PROTDATOS_PASSWORD=

# Origen de cartera para el módulo de deterioro (solo lectura)
DB_FAICO_HOST=
DB_FAICO_PORT=1433
DB_FAICO_DATABASE=Modulos_Faico
DB_FAICO_USERNAME=
DB_FAICO_PASSWORD=

# Bases del ambiente demo (switch por sesión)
DB_DATABASE_DEMO=ArarFinanciera_PRUEBAS
DB_FAICO_DEMO_DATABASE=Modulos_Faico_prueba

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=STARTTLS
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Arar Financiera"

SFTP_HOST=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_ROOT=

JWT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Web service de SIESA (UnoEE)
SIESA_WS_URL=
SIESA_WS_USUARIO=
SIESA_WS_CLAVE=
SIESA_WS_CONEXION=
SIESA_WS_ID_CIA=
SIESA_ENVIO_HABILITADO=false

# Centrales de riesgo (config/centrales.php)
CENTRALES_PREDETERMINADO=transunion
CENTRALES_VIGENCIA_DIAS=30
CENTRALES_SIMULADO=

# TransUnion (CIFIN) - InformacionComercial consultaXml
TRANSUNION_AMBIENTE=pruebas
TRANSUNION_WSDL=
TRANSUNION_USER=
TRANSUNION_PASSWORD=
TRANSUNION_KEY_PATH=
TRANSUNION_CERT_PATH=
TRANSUNION_CODIGO_INFORMACION=5702
TRANSUNION_MOTIVO_CONSULTA=1
TRANSUNION_TIMEOUT=30
TRANSUNION_VERIFY_PEER=true
TRANSUNION_MONTOS_EN_MILES=true

# DataCrédito (Experian) - HC2, pendiente de validar con la especificación oficial
DATACREDITO_AMBIENTE=pruebas
DATACREDITO_ENDPOINT=
DATACREDITO_USUARIO=
DATACREDITO_PASSWORD=
DATACREDITO_CODIGO_SUSCRIPTOR=
DATACREDITO_PRODUCTO=64
DATACREDITO_OPERACION=consultarHC2
DATACREDITO_NAMESPACE=http://ws.hc2.dc.com/v1
DATACREDITO_TIPO_IDENTIFICACION=1
DATACREDITO_CERT_PATH=
DATACREDITO_KEY_PATH=
DATACREDITO_KEY_PASSWORD=
DATACREDITO_TIMEOUT=30
DATACREDITO_VERIFY_PEER=true
DATACREDITO_MONTOS_EN_MILES=true
